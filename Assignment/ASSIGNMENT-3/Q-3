def karatsuba(x, y):
    if x < 10 or y < 10:
        return x * y

    m = max(len(str(x)), len(str(y))) // 2
    p = 10 ** m

    a, b = divmod(x, p)
    c, d = divmod(y, p)

    z2 = karatsuba(a, c)
    z0 = karatsuba(b, d)
    z1 = karatsuba(a + b, c + d) - z2 - z0

    return z2 * p * p + z1 * p + z0


x = int(input("First integer: "))
y = int(input("Second integer: "))

print("Standard:", x * y)
print("Karatsuba:", karatsuba(x, y))
