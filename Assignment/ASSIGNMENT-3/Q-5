from math import hypot


def brute(points):
    best = float("inf")

    for i in range(len(points)):
        for j in range(i + 1, len(points)):
            best = min(
                best,
                hypot(
                    points[i][0] - points[j][0],
                    points[i][1] - points[j][1]
                )
            )

    return best


def closest(points):
    points = sorted(points)

    def solve(px):
        n = len(px)

        if n <= 3:
            return brute(px)

        mid = n // 2
        midx = px[mid][0]

        d = min(solve(px[:mid]), solve(px[mid:]))

        strip = [p for p in px if abs(p[0] - midx) < d]
        strip.sort(key=lambda p: p[1])

        best = d

        for i in range(len(strip)):
            for j in range(i + 1, min(i + 8, len(strip))):
                if strip[j][1] - strip[i][1] >= best:
                    break

                best = min(
                    best,
                    hypot(
                        strip[i][0] - strip[j][0],
                        strip[i][1] - strip[j][1]
                    )
                )

        return best

    return solve(points)


pts = [
    (2, 3), (12, 30), (40, 50),
    (5, 1), (12, 10), (3, 4)
]

print("Closest distance:", closest(pts))
