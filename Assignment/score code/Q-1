def selection_sort(a):
    a = a[:]
    comparisons = swaps = 0

    for i in range(len(a) - 1):
        m = i
        for j in range(i + 1, len(a)):
            comparisons += 1
            if a[j] < a[m]:
                m = j
        if m != i:
            a[i], a[m] = a[m], a[i]
            swaps += 1

    return a, comparisons, swaps


def bubble_sort(a):
    a = a[:]
    comparisons = swaps = 0

    for end in range(len(a) - 1, 0, -1):
        changed = False
        for j in range(end):
            comparisons += 1
            if a[j] > a[j + 1]:
                a[j], a[j + 1] = a[j + 1], a[j]
                swaps += 1
                changed = True
        if not changed:
            break

    return a, comparisons, swaps


def insertion_sort(a):
    a = a[:]
    comparisons = shifts = 0

    for i in range(1, len(a)):
        key = a[i]
        j = i - 1

        while j >= 0:
            comparisons += 1
            if a[j] > key:
                a[j + 1] = a[j]
                shifts += 1
                j -= 1
            else:
                break

        a[j + 1] = key

    return a, comparisons, shifts


tests = {
    "Nearly sorted": [1, 2, 3, 5, 4, 6, 7, 8],
    "Reverse sorted": [8, 7, 6, 5, 4, 3, 2, 1],
    "Empty": [],
    "Single item": [5]
}

for name, data in tests.items():
    print(name, "Selection:", selection_sort(data))
    print(name, "Bubble:", bubble_sort(data))
    print(name, "Insertion:", insertion_sort(data))
